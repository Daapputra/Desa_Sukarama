# ── Database Configuration (PostgreSQL) ─────────────────────
POSTGRES_DB=desasukarama
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rahasia
POSTGRES_PORT=5432

# Connection string used by Backend API (Fastify / Drizzle)
# For Local Dev without Docker: postgresql://postgres:rahasia@localhost:5432/desasukarama
# For Docker Compose: postgresql://postgres:rahasia@db:5432/desasukarama
DATABASE_URL=postgresql://postgres:rahasia@localhost:5432/desasukarama
DATABASE_SSL=false
DB_POOL_MAX=20

# ── Backend API Configuration ───────────────────────────────
API_PORT=3005
PORT=3005

# ── Frontend Configuration (Nuxt 4) ─────────────────────────
# Public URL accessible from user browser
NUXT_PUBLIC_API_BASE=http://localhost:3005

# ── Chatbot AI (opsional) ───────────────────────────────────
# Daftar gratis di https://openrouter.ai, buat API key di /keys.
# Kalau kosong, endpoint /api/chat nonaktif (balas 503, bukan error 500).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
