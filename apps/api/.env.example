# PostgreSQL existing — gunakan koneksi database yang sama dengan aplikasi lama.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/NAMA_DATABASE
API_PORT=3001
# Set true hanya jika penyedia PostgreSQL mengharuskan koneksi SSL.
DATABASE_SSL=false

# Chatbot AI (opsional) — daftar gratis di https://openrouter.ai, buat API key.
# Kalau kosong, endpoint /api/chat akan balas 503 (fitur nonaktif, tidak error 500).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
