{
  "version": 2,
  "builds": [
    {
      "src": "BE/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "FE/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/BE/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/FE/$1"
    }
  ]
}
